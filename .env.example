# Merge Desk server configuration. Copy to .env.local and fill in; never commit
# real values. Check what is set (names only) with: node scripts/env-check.mjs
# Demo mode needs none of these.

# GitHub App (Settings > Developer settings > GitHub Apps), installed on merge-desk only
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The downloaded .pem file's full contents, inside double quotes, keeping its line breaks
GITHUB_APP_PRIVATE_KEY=

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 32+ random bytes, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# These can only narrow the code defaults, never widen them
ALLOWED_LOGINS=YearningAsian
ALLOWED_REPOS=YearningAsian/merge-desk

# sandbox (Vercel Sandbox; authenticates with VERCEL_OIDC_TOKEN from `vercel env pull`) or local
RUNNER=sandbox
DAILY_LIVE_RUN_CAP=30
# Optional: the trusted dependency snapshot printed by `npm run snapshot`
# (main's dependencies, so the sandbox can run the app's own tests)
DEPS_SNAPSHOT_ID=
