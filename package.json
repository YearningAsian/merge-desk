{
  "name": "merge-desk",
  "version": "0.1.0",
  "private": true,
  "description": "AI-proposed merge conflict resolutions that land only after parsing, a choice-honored check and real tests pass.",
  "license": "MIT",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:core": "vitest run",
    "test:playground": "npm test --prefix playground",
    "test:live": "vitest run --config vitest.live.config.mts",
    "e2e": "playwright test",
    "e2e:capture": "tsx scripts/capture-e2e-fixtures.mts",
    "record": "tsx scripts/record.mts",
    "recordings:check": "tsx scripts/check-recordings.mts",
    "facts": "tsx scripts/facts.mts",
    "gate": "tsx scripts/gate.mts",
    "demo:seed": "tsx scripts/demo-seed.mts",
    "demo:reset": "tsx scripts/demo-reset.mts",
    "env:check": "node scripts/env-check.mjs"
  },
  "dependencies": {
    "@google/genai": "2.27.0",
    "@octokit/auth-app": "8.3.1",
    "@octokit/rest": "22.0.1",
    "@pierre/diffs": "1.5.1",
    "@tanstack/react-query": "5.104.1",
    "@vercel/sandbox": "3.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "iron-session": "9.0.1",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
